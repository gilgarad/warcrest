# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env / secrets — never commit these
.env
.env.*
*.pem
*.key

# Build output (placeholder until stack is chosen)
dist/
build/
node_modules/
test-results/

# Python bytecode cache from tools/asset-qa/*.py runs
__pycache__/
*.pyc

# Scratch output from local image generation; not part of the build.
tmp/

# Generated review images; the generator that makes them is what is tracked.
artifacts/
