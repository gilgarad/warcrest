{
  "name": "game_project1",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test tools/validation/audio-integration.spec.ts --workers=1",
    "asset:prepare:golden": "python3 tools/asset-qa/normalize_golden_reference.py",
    "asset:qa:golden": "python3 tools/asset-qa/validate_golden_reference.py",
    "asset:prepare:units": "python3 tools/asset-qa/normalize_golden_reference.py --spec tools/asset-qa/volume-unit-assets.json --output public/assets/production/units && python3 tools/asset-qa/compose_volume_unit_contact_sheet.py",
    "asset:qa:units": "python3 tools/asset-qa/validate_golden_reference.py --spec tools/asset-qa/volume-unit-assets.json --assets public/assets/production/units",
    "asset:prepare:terrain": "python3 tools/asset-qa/generate_terrain_volume.py",
    "asset:qa:terrain": "python3 tools/asset-qa/validate_terrain_volume.py",
    "asset:prepare:props": "python3 tools/asset-qa/normalize_golden_reference.py --spec tools/asset-qa/volume-prop-assets.json --output public/assets/production/props && python3 tools/asset-qa/clean_alpha_assets.py --directory public/assets/production/props --minimum-component 64 && python3 tools/asset-qa/compose_volume_unit_contact_sheet.py --spec tools/asset-qa/volume-prop-assets.json --assets public/assets/production/props --output artifacts/volume-production/props-contact-sheet.png --columns 5",
    "asset:qa:props": "python3 tools/asset-qa/validate_golden_reference.py --spec tools/asset-qa/volume-prop-assets.json --assets public/assets/production/props"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10"
  }
}
